void serviceWiFi() {
  configServer.handleClient();
  if (wifiScanRequested) {
    // ให้การ disconnect จบและส่ง HTTP response ก่อนเริ่ม scan
    if (millis() - wifiScanRequestedAt < 300) return;
    int result = WiFi.scanNetworks(true, false);
    wifiScanRequested = false;
    wifiScanInProgress = (result == WIFI_SCAN_RUNNING);
    wifiLastRetry = millis();
    Serial.println("WiFi scan start: " + String(result));
    return;
  }
  // ไม่สั่งเชื่อมต่อระหว่างสแกน เพื่อไม่ตัดการสแกนที่หน้าเว็บกำลังรอ
  if (wifiScanInProgress) {
    int result = WiFi.scanComplete();
    if (result == WIFI_SCAN_RUNNING) return;
    wifiScanInProgress = false;
    wifiLastRetry = millis();
    Serial.println("WiFi scan complete: " + String(result));
  }
  if (wifiConnectRequested) {
    wifiConnectRequested = false;
    connectWiFi();
  }
  if (WiFi.status() == WL_CONNECTED) {
    if (wifiConnecting) Serial.println("WiFi เชื่อมต่อแล้ว: " + WiFi.localIP().toString());
    wifiConnecting = false;
    return;
  }
  if (wifiConnecting && millis() - wifiAttemptStarted >= 15000) {
    wifiConnecting = false;
    Serial.println("WiFi ยังเชื่อมต่อไม่ได้ ตรวจชื่อ/รหัสผ่านในหน้าเว็บ");
  }
  if (!wifiConnecting && wifiSsid.length() > 0 && millis() - wifiLastRetry >= 30000) connectWiFi();
}

// ================= LittleFS: บันทึกออฟไลน์ + คิว Telegram =================

// ประทับเวลาสำหรับไฟล์บันทึก: ใช้เวลาจริงถ้าเคยซิงก์ NTP ได้ ไม่อย่างนั้นใช้เวลาที่บอร์ดเปิด
String timestampString() {
  if (timeSynced) {
    time_t now = time(NULL);
    struct tm timeinfo;
    localtime_r(&now, &timeinfo);
    char buffer[24];
    strftime(buffer, sizeof(buffer), "%Y-%m-%d %H:%M:%S", &timeinfo);
    return String(buffer);
  }
  return "uptime " + String(millis() / 1000UL) + "s";
}

// รอรับเวลาจาก NTP ครั้งแรก (เรียกเป็นระยะตอนมีอินเทอร์เน็ต ใช้ timeout สั้นไม่บล็อกลูป)
void serviceTime() {
  if (timeSynced) return;
  struct tm timeinfo;
  if (getLocalTime(&timeinfo, 10)) {
    timeSynced = true;
    Serial.println("ซิงก์เวลาสำเร็จ: " + timestampString());
  }
}

// เพิ่มบรรทัดข้อมูลต่อท้ายไฟล์ใน LittleFS
bool appendFileLine(const char* path, const String& line) {
  File file = LittleFS.open(path, FILE_APPEND);
  if (!file) {
    Serial.println(String("LittleFS: เปิด ") + path + " เพื่อเขียนไม่ได้");
    return false;
  }
  file.println(line);
  file.close();
  return true;
}

// แปลงข้อความหลายบรรทัดให้อยู่ในบรรทัดเดียวของไฟล์คิว (เว้นบรรทัดเข้ารหัสเป็น \n)
String escapeQueueText(const String& text) {
  String escaped = text;
  escaped.replace("\t", " ");
  escaped.replace("\r", " ");
  escaped.replace("\n", "\\n");
  return escaped;
}

String unescapeQueueText(const String& text) {
  String unescaped = text;
  unescaped.replace("\\n", "\n");
  return unescaped;
}

// เก็บข้อความแจ้งเตือนลงคิวตอนออฟไลน์ สถานะ P = รอส่ง
bool queueTelegramMessage(const String& message) {
  if (!littleFsReady) return false;
  String line = "P\t" + timestampString() + "\t" + escapeQueueText(message);
  if (!appendFileLine(TELEGRAM_QUEUE_PATH, line)) return false;
  Serial.println("ออฟไลน์: เก็บข้อความแจ้งเตือนลงคิวรอส่ง (" + timestampString() + ")");
  return true;
}

// ชื่อสถานะน้ำสำหรับบันทึกลงไฟล์ CSV
const char* waterStateName() {
  if (waterState == WATER_CRITICAL) return "critical";
  if (waterState == WATER_WARNING) return "warning";
  if (waterState == WATER_NORMAL) return "normal";
  if (waterState == WATER_UNCLASSIFIED) return "unclassified";
  return "inactive";
}

// บันทึกค่าเซนเซอร์ลงไฟล์ CSV ทุก 5 นาที ทำงานทั้งตอนออนไลน์และตอนออฟไลน์
void logSensorRow() {
  if (!littleFsReady) return;
  bool startNewFile = !LittleFS.exists(SENSOR_LOG_PATH);
  if (!startNewFile) {
    File check = LittleFS.open(SENSOR_LOG_PATH, "r");
    if (check) {
      if (check.size() >= SENSOR_LOG_MAX_BYTES) {
        check.close();
        LittleFS.remove(SENSOR_LOG_PATH);
        startNewFile = true;
        Serial.println("LittleFS: ไฟล์บันทึกถึงขนาดกำหนด เริ่มไฟล์ใหม่");
      } else {
        check.close();
      }
    }
  }
  File file = LittleFS.open(SENSOR_LOG_PATH, FILE_APPEND);
  if (!file) {
    Serial.println("LittleFS: เปิดไฟล์บันทึกไม่ได้");
    return;
  }
  if (startNewFile) file.println("time,temp_c,humidity_pct,rain,pressure_mbar,distance_cm,water_state");
  String row = timestampString() + ",";
  row += (isnan(lastTemperature) ? String("") : String(lastTemperature, 1)) + ",";
  row += (isnan(lastHumidity) ? String("") : String(lastHumidity, 0)) + ",";
  row += lastIsRaining ? "rain" : "dry";
  row += ",";
  row += (isnan(lastPressureMbar) ? String("") : String(lastPressureMbar, 1)) + ",";
  row += (isnan(lastDistanceCm) ? String("") : String(lastDistanceCm, 1)) + ",";
  row += waterStateName();
  file.println(row);
  file.close();
}

// ส่งข้อความที่ค้างอยู่ในคิวเมื่อ Wi-Fi กลับมา แล้วทำเครื่องหมาย S = ส่งแล้ว
void flushTelegramQueue() {
  if (!littleFsReady || WiFi.status() != WL_CONNECTED) return;
  if (!LittleFS.exists(TELEGRAM_QUEUE_PATH)) return;
  File file = LittleFS.open(TELEGRAM_QUEUE_PATH, "r");
  if (!file) return;
  const uint8_t MAX_QUEUE_RECORDS = 60;
  String records[MAX_QUEUE_RECORDS];
  uint8_t recordCount = 0;
  while (file.available() && recordCount < MAX_QUEUE_RECORDS) {
    String line = file.readStringUntil('\n');
    line.trim();
    if (line.length() > 0) records[recordCount++] = line;
  }
  if (file.available()) Serial.println("คิวยาวผิดปกติ รายการเก่ากว่าที่อ่านได้จะถูกตัดทิ้ง");
  file.close();

  uint8_t sentNow = 0;
  bool anyPending = false;
  for (uint8_t i = 0; i < recordCount; ++i) {
    if (!records[i].startsWith("P\t")) continue;
    anyPending = true;
    if (sentNow >= 10) continue; //ส่งสูงสุด 10 ข้อความต่อรอบ กันลูปค้างนาน ที่เหลือรอรอบถัดไป
    int firstTab = records[i].indexOf('\t');
    int secondTab = records[i].indexOf('\t', firstTab + 1);
    if (secondTab < 0) continue;
    String queuedAt = records[i].substring(firstTab + 1, secondTab);
    String message = unescapeQueueText(records[i].substring(secondTab + 1));
    bool sent = bot.sendMessage(CHAT_ID, "[" + queuedAt + " ขณะออฟไลน์]\n" + message, "");
    Serial.println(sent ? "ส่งข้อความจากคิวสำเร็จ (" + queuedAt + ")"
                        : "ส่งข้อความจากคิวไม่สำเร็จ (" + queuedAt + ") จะลองใหม่ในรอบถัดไป");
    if (sent) {
      records[i].setCharAt(0, 'S'); //ทำเครื่องหมายในไฟล์ว่าได้ส่งแล้ว
      ++sentNow;
    }
  }
  if (!anyPending) return;

  // เขียนไฟล์กลับ: รายการที่ยังไม่ได้ส่งคงสถานะ P ไว้ ส่วนที่ส่งแล้วเก็บไว้ดูประวัติเฉพาะล่าสุด
  uint8_t sentTotal = 0;
  for (uint8_t i = 0; i < recordCount; ++i) {
    if (records[i].startsWith("S\t")) ++sentTotal;
  }
  uint8_t skipSent = (sentTotal > QUEUE_HISTORY_KEEP) ? sentTotal - QUEUE_HISTORY_KEEP : 0;
  String output;
  for (uint8_t i = 0; i < recordCount; ++i) {
    if (records[i].startsWith("S\t") && skipSent > 0) {
      --skipSent;
      continue;
    }
    output += records[i] + "\n";
  }
  File write = LittleFS.open(TELEGRAM_QUEUE_PATH, FILE_WRITE);
  if (write) {
    write.print(output);
    write.close();
  }
}

