void setup() {
  Serial.begin(115200);
  delay(1000);

  // ตรวจ DHT ก่อน WiFi/HX711 เพื่อแยกปัญหาเซนเซอร์กับระบบค้าง
  dht.begin();
  Serial.println("DHT22: DATA=GPIO21, รอเซนเซอร์พร้อม 2.5 วินาที");
  delay(DHT_READ_INTERVAL);
  readDht22();

  // --- WiFi ---
  loadAlertSettings();
  setupWiFiPortal();
  secured_client.setInsecure(); // ข้ามการตรวจสอบใบรับรอง SSL (ง่ายสำหรับ ESP32 ทั่วไป)

  // --- LittleFS + ซิงก์เวลา NTP (ใช้บันทึกข้อมูลและคิวข้อความตอนออฟไลน์) ---
  littleFsReady = LittleFS.begin(true); // true = ฟอร์แมตอัตโนมัติครั้งแรกที่ยังไม่เคยฟอร์แมต
  Serial.println(littleFsReady ? "LittleFS: พร้อมสำหรับบันทึกข้อมูลตอนออฟไลน์"
                               : "LittleFS: เปิดไม่ได้ จะไม่บันทึกข้อมูล/คิว (ตรวจว่า Partition Scheme มี SPIFFS)");
  // ลบคิวข้อความแจ้งเตือนเก่าที่ค้างจากเวอร์ชันก่อนหน้า ทำครั้งเดียวตอนบูตแรกหลังอัปโหลดโค้ดนี้
  // ธง "done" เก็บใน NVS จึงไม่ลบซ้ำในการบูตครั้งถัดไป คิวออฟไลน์ยังใช้งานได้ตามปกติ
  if (littleFsReady) {
    bool queuePurged = false;
    if (wifiPreferences.begin("queue-purge", true)) {
      queuePurged = wifiPreferences.getBool("done", false);
      wifiPreferences.end();
    }
    if (!queuePurged) {
      Serial.println(LittleFS.remove(TELEGRAM_QUEUE_PATH) ? "ลบข้อความแจ้งเตือนที่ค้างในคิวทั้งหมดแล้ว"
                                                          : "ไม่มีคิวข้อความเก่าให้ลบ");
      if (wifiPreferences.begin("queue-purge", false)) {
        wifiPreferences.putBool("done", true);
        wifiPreferences.end();
      }
    }
  }
  configTzTime("UTC-7", "pool.ntp.org", "time.nist.gov"); //ไทย UTC+7 ตลอดปี ซิงก์อัตโนมัติเมื่อมีอินเทอร์เน็ต

  // --- Rain Module ---
  pinMode(RAIN_DO_PIN, INPUT);

  // --- HX710B ---
  // fastProcessor=true: ESP32 เร็วมาก ต้องมีดีเลย์ 1 µs ระหว่างพัลส์ SCK ตามดาต้าชีต
  // doReset=false: ข้ามการอ่านครั้งแรกที่รอแบบไม่มี timeout ภายใน begin()
  //   กันโปรแกรมค้างตอนบูตถ้าเซนเซอร์ยังไม่พร้อม (initializeScaleZero เช็คด้วย timeout เอง)
  scale.begin(HX710B_DT_PIN, HX710B_SCK_PIN, true, false);
  scale.set_scale(calibration_factor);
  scaleZeroReady = initializeScaleZero(); // ไม่มีความดันตอนเริ่ม ตั้งค่าจุดศูนย์

  // --- JSN-SR04T ---
  pinMode(TRIG_PIN, OUTPUT);
  pinMode(ECHO_PIN, INPUT);
  digitalWrite(TRIG_PIN, LOW);

  Serial.println("=== ESP32 Multi-Sensor Monitoring Started ===");
}

void loop() {
  serviceWiFi();//serviceWiFi() เพื่อจัดการคำขอจากหน้าเว็บ ตรวจสถานะ Wi-Fi และควบคุมการเชื่อมต่อเบื้องหลัง

  bool connectedNow = WiFi.status() == WL_CONNECTED;
  if (connectedNow) serviceTime(); //รอซิงก์เวลาจาก NTP ครั้งแรกที่มีอินเทอร์เน็ต
  if (connectedNow && !wasWifiConnected) {
    lastQueueFlushMs = millis() - 30000; //Wi-Fi เพิ่งกลับมา ให้ตรวจคิวทันทีในรอบนี้
    Serial.println("Wi-Fi กลับมา: ตรวจข้อความแจ้งเตือนที่ค้างอยู่ในคิว");
  }
  wasWifiConnected = connectedNow;
  if (connectedNow && millis() - lastQueueFlushMs >= 30000) {
    lastQueueFlushMs = millis();
    flushTelegramQueue(); //ส่งข้อความที่ค้างอยู่ (ถ้ามี) แล้วทำเครื่องหมายในไฟล์ว่าส่งแล้ว
  }

  if (millis() - lastDhtReadTime >= DHT_READ_INTERVAL) {
    readDht22();
  }
  if (millis() - lastReadTime >= READ_INTERVAL) {
    lastReadTime = millis();

    float temperature = dhtTemperature;
    float humidity    = dhtHumidity;
    bool  isRaining   = readRainConfirmed();
    float pressureMbar = readPressureMbar();
    float distanceCm  = readDistanceCm();

    printResults(temperature, humidity, isRaining, pressureMbar, distanceCm);

    // เก็บค่าล่าสุดไว้ใช้ตอนส่ง Telegram (ต้องเก็บก่อนตรวจระดับน้ำ)
    lastTemperature = temperature;
    lastHumidity    = humidity;
    lastIsRaining   = isRaining;
    lastPressureMbar = pressureMbar;
    lastDistanceCm  = distanceCm;
    lastSensorUpdate = millis();
    sensorHasUpdated = true;
    checkRainStartAlert(isRaining); //เพิ่งยืนยันว่าฝนตก: แจ้งเตือน 1 ครั้ง

    if (littleFsReady && millis() - lastSensorLogMs >= SENSOR_LOG_INTERVAL_MS) {
      lastSensorLogMs = millis();
      logSensorRow(); //บันทึกค่าเซนเซอร์ลง LittleFS ทุก 5 นาที ทั้งตอนออนไลน์และออฟไลน์
    }

    checkWaterLevel(distanceCm);   // ตรวจระดับน้ำและแจ้งเตือน
    checkHumidityAlert();          // ตรวจค่าความชื้นและแจ้งเตือน
  }

}

