  Serial.print("สถานะฝน            : ");
  Serial.println(rainStatusText(raining));

  Serial.print("น้ำหนัก/แรงกด       : ");
  isnan(pressure) ? Serial.println("อ่านค่าไม่ได้") : Serial.println(String(pressure, 1) + " mbar");

