void connectWiFi() {
  if (wifiSsid.length() == 0) return;
  WiFi.disconnect(false, false); // คง AP สำหรับตั้งค่าไว้
  WiFi.begin(wifiSsid.c_str(), wifiPassword.c_str());
  wifiConnecting = true;
  wifiAttemptStarted = millis();
  wifiLastRetry = millis();
  Serial.println("กำลังเชื่อมต่อ WiFi: " + wifiSsid);
}

String escapeHtml(const String& value) {
  String escaped = value;
  escaped.replace("&", "&amp;");
  escaped.replace("<", "&lt;");
  escaped.replace(">", "&gt;");
  escaped.replace("\"", "&quot;");
  escaped.replace("'", "&#39;");
  return escaped;
}

